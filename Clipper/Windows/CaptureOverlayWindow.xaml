<Window x:Class="Clipper.Windows.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        KeyDown="Window_KeyDown">
    <Grid x:Name="OverlayGrid" Background="#33000000">
        <Canvas>
            <Rectangle x:Name="SelectionRect"
                       Stroke="White"
                       StrokeThickness="1"
                       StrokeDashArray="4 2"
                       Fill="#33FFFFFF"
                       Visibility="Collapsed"/>
        </Canvas>
        
        <TextBlock x:Name="InstructionText" 
                   Text="Drag to select region, Click for window, ESC to cancel" 
                   Foreground="White" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   FontSize="20"
                   IsHitTestVisible="False">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="2"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
