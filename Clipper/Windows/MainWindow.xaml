<ui:FluentWindow x:Class="Clipper.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Clipper.Windows"
        mc:Ignorable="d"
        Title="Clipper" Height="520" Width="420"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        Deactivated="MainWindow_Deactivated">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </ui:FluentWindow.Resources>

    <Grid Margin="6,4,6,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <ui:TitleBar Grid.Row="0" Title="Clipper" ShowMaximize="False" ShowMinimize="False" Height="30" Margin="0,0,0,4"/>

        <Grid x:Name="headerGrid" Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="txtSearch" Grid.Column="0" Margin="0,0,4,0"
                        PlaceholderText="Search clipboard..."
                        Icon="{ui:SymbolIcon Symbol=Search24}"
                        ClearButtonEnabled="True"
                        Padding="6,3"
                        MinHeight="30"
                        FontSize="12"
                        TextChanged="TxtSearch_TextChanged"/>
            <ui:Button Grid.Column="1" ToolTip="Screen Capture (Ctrl+Shift+S)" Click="Capture_Click" 
                       Icon="{ui:SymbolIcon Symbol=Camera24}" 
                       Margin="0,0,4,0" Padding="6,3" MinHeight="30" Appearance="Secondary"/>
            <ui:Button Grid.Column="2" ToolTip="Clipboard Patterns" Click="ShowPatterns_Click" 
                       Icon="{ui:SymbolIcon Symbol=DocumentBulletList24}" 
                       Margin="0,0,4,0" Padding="6,3" MinHeight="30" Appearance="Secondary"/>
            <ui:Button Grid.Column="3" ToolTip="Settings" Click="ShowSettings_Click" 
                       Icon="{ui:SymbolIcon Symbol=Settings24}" 
                       Margin="0" Padding="6,3" MinHeight="30" Appearance="Secondary"/>
        </Grid>

        <Grid Grid.Row="2">
            <ListBox x:Name="lstHistory" Margin="0" Padding="0"
                     MouseDoubleClick="LstHistory_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="4,4,4,4" HorizontalAlignment="Stretch" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding DisplayText}" 
                                               FontFamily="Cascadia Code, Consolas, Courier New" 
                                               FontSize="12" 
                                               FontWeight="Normal" 
                                               TextWrapping="Wrap" 
                                               LineHeight="16"
                                               MaxHeight="90"
                                               TextTrimming="CharacterEllipsis"/>
                                    <DockPanel Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" 
                                                   FontSize="10" 
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <ItemsControl ItemsSource="{Binding Actions}" Visibility="{Binding HasActions, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ui:Button Content="{Binding Label}" Click="Action_Click" 
                                                               Margin="0,0,4,0" Padding="6,1" MinHeight="20"
                                                               Appearance="Secondary" FontSize="10"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </StackPanel>

                                <Rectangle Grid.Column="1" Width="42" Height="42" RadiusX="3" RadiusY="3" Margin="2,0,0,0"
                                           VerticalAlignment="Center" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1"
                                           Visibility="{Binding HasColorPreview, Converter={StaticResource BoolToVis}}"
                                           Fill="{Binding ColorPreview}"/>

                                <Border Grid.Column="1" Width="42" Height="42" CornerRadius="3" Margin="2,0,0,0"
                                        VerticalAlignment="Center" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                        Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"
                                        ClipToBounds="True">
                                    <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Grid>
</ui:FluentWindow>