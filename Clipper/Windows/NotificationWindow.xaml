<Window x:Class="Clipper.Windows.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Notification" Height="Auto" Width="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" SizeToContent="Height">
    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" 
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
            BorderThickness="1" CornerRadius="8" Margin="6" Padding="8,6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Opacity="0.4" ShadowDepth="3" Direction="270"/>
        </Border.Effect>
        <StackPanel>
            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                <ui:Button DockPanel.Dock="Right" Click="Close_Click" 
                           Icon="{ui:SymbolIcon Symbol=Dismiss20}"
                           Appearance="Transparent"
                           Padding="2" MinHeight="20" Width="20" Height="20"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ClipboardLetter20" FontSize="14" Margin="0,0,5,0" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <TextBlock Text="Clipper Match" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
            
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="txtContent" 
                           Grid.Column="0"
                           FontFamily="Cascadia Code, Consolas, Courier New" 
                           TextWrapping="Wrap" 
                           MaxHeight="80" 
                           LineHeight="15"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                           FontSize="11.5"
                           VerticalAlignment="Center"/>
                
                <Rectangle x:Name="rectColorPreview" 
                           Grid.Column="1" 
                           Width="32" Height="32" 
                           RadiusX="4" RadiusY="4" 
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" 
                           StrokeThickness="1"
                           Visibility="Collapsed"/>
                
                <Border x:Name="borderImagePreview"
                        Grid.Column="1"
                        Width="32" Height="32"
                        CornerRadius="4"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed"
                        ClipToBounds="True">
                    <Image x:Name="imgPreview" Stretch="UniformToFill"/>
                </Border>
            </Grid>
            
            <ItemsControl x:Name="itemsActions">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Button Content="{Binding Label}" Click="Action_Click" Margin="0,0,4,4" 
                                   Appearance="Secondary" Padding="6,2" MinHeight="22" FontSize="11"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
