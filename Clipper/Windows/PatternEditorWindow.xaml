<ui:FluentWindow x:Class="Clipper.Windows.PatternEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Clipper.Windows"
        xmlns:root="clr-namespace:Clipper"
        Title="Clipboard Pattern Editor" Height="580" Width="780"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="8,4,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Clipboard Pattern Editor" ShowMaximize="False" ShowMinimize="False" Height="30" Margin="0,0,0,6"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Pattern List -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="Patterns" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <ui:Button Content="Add" Click="AddPattern_Click" Icon="{ui:SymbolIcon Symbol=Add24}" Margin="0,0,4,0" Padding="8,4" MinHeight="28" Appearance="Primary"/>
                    <ui:Button Content="Delete" Click="DeletePattern_Click" Icon="{ui:SymbolIcon Symbol=Delete24}" Padding="8,4" MinHeight="28" Appearance="Secondary"/>
                </StackPanel>
                <ListBox x:Name="lstPatterns" DisplayMemberPath="Name" SelectionChanged="LstPatterns_SelectionChanged"
                         Background="Transparent" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="MinHeight" Value="28"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>

            <!-- Right Pane: Pattern Details -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0" Padding="0,0,4,0">
                <StackPanel x:Name="pnlDetails" Visibility="Collapsed">
                    <TextBlock Text="Pattern Details" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    
                    <TextBlock Text="Name" FontSize="11" Margin="0,0,0,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ui:TextBox x:Name="txtName" Margin="0,0,0,6" MinHeight="28" Padding="6,2" FontSize="12"/>

                    <TextBlock Text="Regex Pattern" FontSize="11" Margin="0,0,0,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ui:TextBox x:Name="txtRegex" Margin="0,0,0,8" MinHeight="28" Padding="6,2" FontSize="12" FontFamily="Cascadia Code, Consolas, Courier New"/>

                    <TextBlock Text="Actions" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,4"/>
                    <ItemsControl x:Name="itemsActions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" 
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        Padding="6,4" Margin="0,0,0,4" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="Label" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <ui:TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Padding="5,2" MinHeight="26" FontSize="12"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <TextBlock Text="Type" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <ComboBox SelectedValue="{Binding Type}" SelectedValuePath="Tag" Padding="6,2" MinHeight="26" FontSize="12" MinWidth="100">
                                                        <ComboBoxItem Content="Open URL" Tag="{x:Static root:ClipboardActionType.OpenUrl}"/>
                                                        <ComboBoxItem Content="Search Web" Tag="{x:Static root:ClipboardActionType.SearchWeb}"/>
                                                        <ComboBoxItem Content="Copy Match" Tag="{x:Static root:ClipboardActionType.Copy}"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Parameter Template ({0} is the match)" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                                            <ui:TextBox Text="{Binding ParameterTemplate, UpdateSourceTrigger=PropertyChanged}" Padding="5,2" MinHeight="26" FontSize="12" FontFamily="Cascadia Code, Consolas, Courier New"/>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" Click="RemoveAction_Click" Icon="{ui:SymbolIcon Symbol=Delete24}" 
                                                   VerticalAlignment="Top" Margin="6,0,0,0" Padding="4" MinHeight="26" Appearance="Secondary" ToolTip="Remove action"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <DockPanel Margin="0,4,0,0">
                        <ui:Button Content="Add Action" Click="AddAction_Click" Icon="{ui:SymbolIcon Symbol=Add24}" 
                                   DockPanel.Dock="Left" Padding="8,3" MinHeight="28" Appearance="Secondary"/>
                        <ui:Button Content="Save All Changes" Click="SaveAll_Click" Icon="{ui:SymbolIcon Symbol=Save24}" 
                                   DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="12,4" MinHeight="28" Appearance="Primary" FontWeight="SemiBold"/>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
